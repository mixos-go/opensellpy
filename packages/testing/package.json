{
  "name": "@mixos-go/opensellpy-testing",
  "version": "0.1.0",
  "description": "OpenSellPy — fixtures + mock adapters for tests. Must NOT depend on any @mixos-go SDK.",
  "publishConfig": {
    "access": "restricted"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "node --test 'dist/**/*.test.js'"
  },
  "dependencies": {
    "@mixos-go/opensellpy-client": "workspace:*",
    "@mixos-go/opensellpy-core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
